<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="codecraftersPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>


        <class>codecrafters.modelo.Persona</class>
        <class>codecrafters.modelo.Cliente</class>
        <class>codecrafters.modelo.Empleado</class>
        <class>codecrafters.modelo.Hotel</class>
        <class>codecrafters.modelo.Habitacion</class>
        <class>codecrafters.modelo.Reserva</class>
        <class>codecrafters.modelo.LineaReserva</class>
    
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/codecrafters_producto3"/>
            <property name="jakarta.persistence.jdbc.user" value="codecrafters_app"/>

            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
